# Site Configuration
SITE_URL=https://biblestudyhub.com
SITE_NAME=Bible Study Hub
SITE_DESCRIPTION=AI-Powered Bible Study Platform

# Email Configuration
COMPANY_EMAIL=support@biblestudyhub.com
SUPPORT_EMAIL=support@biblestudyhub.com
LEGAL_EMAIL=legal@biblestudyhub.com

# Payment Processing
RAZORPAY_KEY_ID=your_razorpay_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
STRIPE_KEY_ID=your_stripe_key_here

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token_here

# Database
DATABASE_URL=your_database_url_here
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# Authentication
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# CDN & Storage
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
AWS_BUCKET_NAME=biblestudyhub-assets
AWS_REGION=us-east-1

# Feature Flags
ENABLE_BETA_FEATURES=false
ENABLE_ANALYTICS=true
ENABLE_NEWSLETTER=true

# Development
DEBUG=false
LOG_LEVEL=info
NODE_ENV=production
