---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/ui/Section.astro';

const pageTitle = 'Privacy Policy - Bible Study Hub';
const pageDescription = 'Our privacy policy and how we handle your data.';
---

<MainLayout title={pageTitle} description={pageDescription}>
  <Section class="max-w-4xl mx-auto">
    <h1 class="text-5xl font-bold text-gray-900 mb-8">Privacy Policy</h1>
    <p class="text-gray-600 text-sm mb-8">Last updated: July 2026</p>

    <div class="prose prose-lg max-w-none text-gray-700 space-y-8">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">1. Introduction</h2>
        <p>
          Bible Study Hub ("we," "us," "our," or "Company") operates the Bible Study Hub extension and website. This Privacy Policy explains our data practices and your privacy rights.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">2. Information We Collect</h2>
        <p>We collect information in the following ways:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Account Information:</strong> Email, name, and profile preferences</li>
          <li><strong>Usage Data:</strong> Which passages you study, highlights, and notes</li>
          <li><strong>Device Information:</strong> Browser type, OS, and device identifiers</li>
          <li><strong>Analytics:</strong> Page views, features used, and interaction patterns</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">3. How We Use Your Information</h2>
        <p>We use your information to:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>Provide and improve our services</li>
          <li>Personalize your experience</li>
          <li>Send service updates and support messages</li>
          <li>Prevent fraud and ensure security</li>
          <li>Analyze usage patterns to improve features</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">4. Data Security</h2>
        <p>
          We implement industry-standard security measures to protect your data, including encryption, secure servers, and regular security audits. However, no system is completely secure, and we cannot guarantee absolute security.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">5. Third-Party Services</h2>
        <p>
          We may use third-party services for analytics, payment processing, and hosting. These providers are contractually obligated to protect your data and not use it for their own purposes.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">6. Your Rights</h2>
        <p>You have the right to:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>Access your personal data</li>
          <li>Correct inaccurate information</li>
          <li>Request deletion of your data</li>
          <li>Opt-out of marketing communications</li>
          <li>Export your data</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">7. Cookies and Tracking</h2>
        <p>
          We use cookies to enhance your experience, remember preferences, and analyze usage. You can disable cookies in your browser settings, but some features may not work properly.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">8. Data Retention</h2>
        <p>
          We retain your data as long as your account is active. When you delete your account, we will delete your personal data within 30 days, except where legally required to retain it.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">9. Contact Us</h2>
        <p>
          If you have questions about this Privacy Policy or our data practices, please contact us at:
          <br />
          <strong>Email:</strong> privacy@biblestudyhub.com
          <br />
          <strong>Address:</strong> Bible Study Hub, 123 Scripture Lane, Theology City, TC 12345
        </p>
      </div>
    </div>
  </Section>
</MainLayout>
