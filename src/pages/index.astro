---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bible Study Hub - AI-Powered Bible Learning">
  <!-- Hero Section -->
  <section class="relative min-h-screen bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-900 text-white overflow-hidden">
    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-400/20 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-indigo-400/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
      <div class="absolute top-1/2 left-1/3 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 4s;"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-32 flex flex-col justify-center items-center min-h-screen text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 hover:border-white/40 transition">
        <span class="text-sm font-semibold text-purple-100">✨ Trusted by Bible Scholars</span>
      </div>

      <!-- Main heading with gradient text -->
      <h1 class="text-6xl md:text-7xl lg:text-8xl font-black mb-6 leading-tight">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-purple-100 to-white">
          📖 Bible Study
        </span>
        <br>
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-yellow-200 via-orange-200 to-yellow-200">
          Reimagined
        </span>
      </h1>

      <!-- Subheading -->
      <p class="text-xl md:text-2xl text-purple-100 mb-4 max-w-2xl leading-relaxed">
        Master Scripture with <span class="text-yellow-200 font-bold">AI-Powered Insights</span>
      </p>
      <p class="text-lg text-purple-200 mb-12 max-w-xl">
        Get instant summaries, deep analysis, and contextual understanding of every Bible passage
      </p>

      <!-- Stats with cards -->
      <div class="grid grid-cols-3 gap-6 mb-16 w-full max-w-2xl">
        <div class="group bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 hover:bg-white/20 hover:border-white/40 transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="text-4xl font-black text-yellow-300 mb-2">10K+</div>
          <div class="text-purple-200 font-semibold text-sm">Active Users</div>
        </div>
        <div class="group bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 hover:bg-white/20 hover:border-white/40 transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="text-4xl font-black text-yellow-300 mb-2">4.8★</div>
          <div class="text-purple-200 font-semibold text-sm">Rating</div>
        </div>
        <div class="group bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 hover:bg-white/20 hover:border-white/40 transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="text-4xl font-black text-yellow-300 mb-2">100%</div>
          <div class="text-purple-200 font-semibold text-sm">Free Forever</div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://chrome.google.com/webstore" target="_blank"
           class="group relative px-10 py-4 bg-gradient-to-r from-yellow-400 to-orange-400 text-purple-900 font-bold text-lg rounded-xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:scale-105 active:scale-95">
          <div class="absolute inset-0 bg-gradient-to-r from-yellow-300 to-orange-300 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <span class="relative flex items-center gap-2">
            📥 Download Extension (FREE)
          </span>
        </a>
        <a href="#features"
           class="group px-10 py-4 bg-white/10 backdrop-blur-md border-2 border-white/30 text-white font-bold text-lg rounded-xl hover:bg-white/20 hover:border-white/60 transition-all duration-300 hover:shadow-2xl hover:scale-105 active:scale-95">
          <span class="flex items-center gap-2">
            Explore Features ↓
          </span>
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
        <span class="text-purple-200 text-sm font-semibold">Scroll to explore</span>
        <div class="w-6 h-10 border-2 border-purple-200 rounded-full flex items-start justify-center pt-2">
          <div class="w-1 h-2 bg-purple-200 rounded-full animate-pulse"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-32 bg-gradient-to-b from-white via-purple-50/30 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-100/40 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-100/40 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4">
      <!-- Section header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-100 border border-purple-200 mb-4">
          <span class="text-sm font-bold text-purple-700">✨ POWERFUL FEATURES</span>
        </div>
        <h2 class="text-5xl md:text-6xl font-black mb-4 text-gray-900">
          Everything You Need to <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-blue-600">Master Scripture</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Advanced AI-powered tools designed to transform how you study the Bible
        </p>
      </div>

      <!-- Features Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature Card 1 -->
        <div class="group relative bg-gradient-to-br from-blue-50 via-blue-25 to-cyan-50 p-8 rounded-2xl border border-blue-200/50 hover:border-blue-300 transition-all duration-500 hover:shadow-2xl hover:scale-105 cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <div class="text-5xl mb-4 inline-block p-3 bg-blue-100 rounded-xl group-hover:bg-blue-200 transition-colors">📌</div>
            <h3 class="text-2xl font-bold mb-3 text-blue-900">Instant Summaries</h3>
            <p class="text-gray-700 leading-relaxed">
              Get concise, AI-powered summaries of any Bible passage in seconds. Perfect for quick understanding and daily devotions.
            </p>
            <div class="mt-4 flex items-center gap-2 text-blue-600 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more →
            </div>
          </div>
        </div>

        <!-- Feature Card 2 -->
        <div class="group relative bg-gradient-to-br from-emerald-50 via-emerald-25 to-teal-50 p-8 rounded-2xl border border-emerald-200/50 hover:border-emerald-300 transition-all duration-500 hover:shadow-2xl hover:scale-105 cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <div class="text-5xl mb-4 inline-block p-3 bg-emerald-100 rounded-xl group-hover:bg-emerald-200 transition-colors">🔑</div>
            <h3 class="text-2xl font-bold mb-3 text-emerald-900">Key Points & Themes</h3>
            <p class="text-gray-700 leading-relaxed">
              Discover main theological concepts and important messages hidden in scripture with intelligent theme extraction.
            </p>
            <div class="mt-4 flex items-center gap-2 text-emerald-600 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more →
            </div>
          </div>
        </div>

        <!-- Feature Card 3 -->
        <div class="group relative bg-gradient-to-br from-orange-50 via-orange-25 to-amber-50 p-8 rounded-2xl border border-orange-200/50 hover:border-orange-300 transition-all duration-500 hover:shadow-2xl hover:scale-105 cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-orange-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <div class="text-5xl mb-4 inline-block p-3 bg-orange-100 rounded-xl group-hover:bg-orange-200 transition-colors">🔗</div>
            <h3 class="text-2xl font-bold mb-3 text-orange-900">Cross References</h3>
            <p class="text-gray-700 leading-relaxed">
              Find related passages and connections across the Bible to deepen your understanding of scriptures.
            </p>
            <div class="mt-4 flex items-center gap-2 text-orange-600 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more →
            </div>
          </div>
        </div>

        <!-- Feature Card 4 -->
        <div class="group relative bg-gradient-to-br from-rose-50 via-rose-25 to-pink-50 p-8 rounded-2xl border border-rose-200/50 hover:border-rose-300 transition-all duration-500 hover:shadow-2xl hover:scale-105 cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-rose-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <div class="text-5xl mb-4 inline-block p-3 bg-rose-100 rounded-xl group-hover:bg-rose-200 transition-colors">📚</div>
            <h3 class="text-2xl font-bold mb-3 text-rose-900">Historical Context</h3>
            <p class="text-gray-700 leading-relaxed">
              Learn cultural, historical, and theological background to understand the world of scripture.
            </p>
            <div class="mt-4 flex items-center gap-2 text-rose-600 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more →
            </div>
          </div>
        </div>

        <!-- Feature Card 5 -->
        <div class="group relative bg-gradient-to-br from-fuchsia-50 via-fuchsia-25 to-purple-50 p-8 rounded-2xl border border-fuchsia-200/50 hover:border-fuchsia-300 transition-all duration-500 hover:shadow-2xl hover:scale-105 cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <div class="text-5xl mb-4 inline-block p-3 bg-fuchsia-100 rounded-xl group-hover:bg-fuchsia-200 transition-colors">❓</div>
            <h3 class="text-2xl font-bold mb-3 text-fuchsia-900">Custom Questions</h3>
            <p class="text-gray-700 leading-relaxed">
              Ask anything about passages and get AI-powered answers grounded in scripture and theology.
            </p>
            <div class="mt-4 flex items-center gap-2 text-fuchsia-600 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more →
            </div>
          </div>
        </div>

        <!-- Feature Card 6 -->
        <div class="group relative bg-gradient-to-br from-indigo-50 via-indigo-25 to-blue-50 p-8 rounded-2xl border border-indigo-200/50 hover:border-indigo-300 transition-all duration-500 hover:shadow-2xl hover:scale-105 cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <div class="text-5xl mb-4 inline-block p-3 bg-indigo-100 rounded-xl group-hover:bg-indigo-200 transition-colors">🔐</div>
            <h3 class="text-2xl font-bold mb-3 text-indigo-900">100% Secure & Private</h3>
            <p class="text-gray-700 leading-relaxed">
              Your API key is stored locally. Zero data collection. Your study remains completely private always.
            </p>
            <div class="mt-4 flex items-center gap-2 text-indigo-600 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more →
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-32 bg-gradient-to-b from-gray-50 via-white to-purple-50/30 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-1/2 -right-40 w-96 h-96 bg-gradient-to-br from-purple-200/20 to-indigo-200/20 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 -left-40 w-80 h-80 bg-gradient-to-tr from-blue-200/20 to-purple-200/20 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4">
      <!-- Section Header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-100 border border-purple-200 mb-4">
          <span class="text-sm font-bold text-purple-700">🎯 SIMPLE PROCESS</span>
        </div>
        <h2 class="text-5xl md:text-6xl font-black mb-4 text-gray-900">
          Get Started in <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-blue-600">3 Simple Steps</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Start studying smarter with our intuitive extension in under a minute
        </p>
      </div>

      <!-- Steps Container -->
      <div class="grid md:grid-cols-3 gap-8 relative">
        <!-- Connection line -->
        <div class="hidden md:block absolute top-24 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-purple-200 to-transparent -z-10"></div>

        <!-- Step 1 -->
        <div class="group relative">
          <div class="relative z-20 bg-white rounded-3xl p-8 border-2 border-gray-100 hover:border-purple-300 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
            <!-- Step number -->
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 text-white text-3xl font-black flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform duration-300 shadow-lg">
              1
            </div>

            <h3 class="text-2xl font-bold text-center mb-4 text-gray-900">Install Extension</h3>
            <p class="text-gray-600 text-center leading-relaxed">
              Download the Bible Study extension from Chrome Web Store. Takes less than 1 minute with zero hassle.
            </p>

            <!-- Icon -->
            <div class="mt-6 text-5xl text-center opacity-50 group-hover:opacity-100 transition-opacity">
              💻
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="group relative md:mt-8">
          <div class="relative z-20 bg-white rounded-3xl p-8 border-2 border-gray-100 hover:border-purple-300 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
            <!-- Step number -->
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 text-white text-3xl font-black flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform duration-300 shadow-lg">
              2
            </div>

            <h3 class="text-2xl font-bold text-center mb-4 text-gray-900">Select a Passage</h3>
            <p class="text-gray-600 text-center leading-relaxed">
              Visit biblegateway.com and select any Bible verse, passage, or entire chapter to study.
            </p>

            <!-- Icon -->
            <div class="mt-6 text-5xl text-center opacity-50 group-hover:opacity-100 transition-opacity">
              📖
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="group relative">
          <div class="relative z-20 bg-white rounded-3xl p-8 border-2 border-gray-100 hover:border-purple-300 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
            <!-- Step number -->
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-indigo-500 to-indigo-600 text-white text-3xl font-black flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform duration-300 shadow-lg">
              3
            </div>

            <h3 class="text-2xl font-bold text-center mb-4 text-gray-900">Get Insights</h3>
            <p class="text-gray-600 text-center leading-relaxed">
              Click the extension icon to get instant AI-powered insights and deep analysis of scripture.
            </p>

            <!-- Icon -->
            <div class="mt-6 text-5xl text-center opacity-50 group-hover:opacity-100 transition-opacity">
              ✨
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="text-center mt-16">
        <p class="text-gray-600 mb-6">Ready to transform your Bible study experience?</p>
        <a href="https://chrome.google.com/webstore" target="_blank"
           class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold rounded-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 active:scale-95">
          📥 Download Free Extension
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-32 bg-gradient-to-b from-white via-blue-50/20 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-100/30 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-100/30 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4">
      <!-- Section Header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-100 border border-purple-200 mb-4">
          <span class="text-sm font-bold text-purple-700">💬 TESTIMONIALS</span>
        </div>
        <h2 class="text-5xl md:text-6xl font-black mb-4 text-gray-900">
          Loved by <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-blue-600">Bible Scholars</span> & Students
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          See how thousands of people have transformed their Bible study journey
        </p>
      </div>

      <!-- Testimonials Grid -->
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Testimonial 1 -->
        <div class="group relative">
          <div class="relative h-full bg-gradient-to-br from-white to-purple-50/50 rounded-2xl p-8 border border-gray-200 hover:border-purple-300 hover:shadow-2xl transition-all duration-500 overflow-hidden">
            <!-- Gradient overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10">
              <!-- Stars -->
              <div class="text-yellow-400 mb-4 text-2xl">⭐⭐⭐⭐⭐</div>

              <!-- Quote mark -->
              <div class="text-5xl text-purple-200 mb-4 leading-none">"</div>

              <!-- Testimonial text -->
              <p class="text-gray-700 mb-6 leading-relaxed font-medium">
                This extension has completely transformed how I study the Bible. The AI insights are incredibly helpful and make deep scripture understanding accessible to everyone!
              </p>

              <!-- Author info -->
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center text-white font-bold text-lg">
                  S
                </div>
                <div>
                  <p class="font-bold text-gray-900">Sarah M.</p>
                  <p class="text-sm text-gray-600">Bible Teacher</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="group relative md:mt-8">
          <div class="relative h-full bg-gradient-to-br from-white to-blue-50/50 rounded-2xl p-8 border border-gray-200 hover:border-blue-300 hover:shadow-2xl transition-all duration-500 overflow-hidden">
            <!-- Gradient overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10">
              <!-- Stars -->
              <div class="text-yellow-400 mb-4 text-2xl">⭐⭐⭐⭐⭐</div>

              <!-- Quote mark -->
              <div class="text-5xl text-blue-200 mb-4 leading-none">"</div>

              <!-- Testimonial text -->
              <p class="text-gray-700 mb-6 leading-relaxed font-medium">
                Finally, a tool that helps me understand scripture deeper without overwhelming me with too much information. It's perfectly balanced for learning!
              </p>

              <!-- Author info -->
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-bold text-lg">
                  D
                </div>
                <div>
                  <p class="font-bold text-gray-900">David K.</p>
                  <p class="text-sm text-gray-600">Daily Bible Reader</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="group relative">
          <div class="relative h-full bg-gradient-to-br from-white to-indigo-50/50 rounded-2xl p-8 border border-gray-200 hover:border-indigo-300 hover:shadow-2xl transition-all duration-500 overflow-hidden">
            <!-- Gradient overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10">
              <!-- Stars -->
              <div class="text-yellow-400 mb-4 text-2xl">⭐⭐⭐⭐⭐</div>

              <!-- Quote mark -->
              <div class="text-5xl text-indigo-200 mb-4 leading-none">"</div>

              <!-- Testimonial text -->
              <p class="text-gray-700 mb-6 leading-relaxed font-medium">
                The context feature is absolutely amazing! I now understand the cultural and historical background of passages like never before. Game-changing!
              </p>

              <!-- Author info -->
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white font-bold text-lg">
                  L
                </div>
                <div>
                  <p class="font-bold text-gray-900">Lisa P.</p>
                  <p class="text-sm text-gray-600">Theology Student</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Premium Section -->
  <section class="py-32 bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-900 text-white relative overflow-hidden">
    <!-- Animated background -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-purple-400/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-indigo-400/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-5xl md:text-6xl font-black mb-6">
          ✨ Unlock Premium <span class="bg-clip-text text-transparent bg-gradient-to-r from-yellow-200 to-orange-200">Features</span>
        </h2>
        <p class="text-xl text-purple-200 max-w-2xl mx-auto">
          Get advanced features with our Premium plan. Try free for 14 days!
        </p>
      </div>

      <!-- Pricing Cards Grid -->
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <!-- Free Plan -->
        <div class="group relative rounded-2xl border border-white/20 bg-white/5 backdrop-blur-md p-8 hover:border-white/40 hover:bg-white/10 transition-all duration-500 hover:scale-105 hover:shadow-2xl">
          <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl"></div>

          <div class="relative z-10">
            <div class="text-4xl mb-4">📝</div>
            <h3 class="text-2xl font-bold mb-2">Free Forever</h3>
