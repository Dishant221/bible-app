---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Features - Bible Study Hub Extension">
  <!-- Hero Section -->
  <section class="relative min-h-screen bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-900 text-white overflow-hidden flex items-center">
    <!-- Animated background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-indigo-400/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
      <div class="absolute top-1/2 left-1/3 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 4s;"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 w-full py-32 text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 hover:border-white/40 transition">
        <span class="text-sm font-semibold text-blue-100">✨ Complete Feature Overview</span>
      </div>

      <!-- Main heading -->
      <h1 class="text-6xl md:text-7xl lg:text-8xl font-black mb-6 leading-tight">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-100 to-white">
          Powerful
        </span>
        <br>
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-yellow-200 via-orange-200 to-yellow-200">
          Features
        </span>
      </h1>

      <!-- Subheading -->
      <p class="text-xl md:text-2xl text-blue-100 mb-4 max-w-2xl mx-auto leading-relaxed">
        Everything you need for <span class="text-yellow-200 font-bold">deep Bible study</span>
      </p>
      <p class="text-lg text-blue-200 max-w-xl mx-auto">
        Advanced AI-powered tools designed to unlock scripture's deeper meaning
      </p>
    </div>
  </section>

  <!-- Feature Details Section -->
  <section class="py-32 bg-gradient-to-b from-white via-gray-50/50 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-blue-100/40 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-100/40 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 space-y-32">
      <!-- Feature 1: Summarize -->
      <div class="group">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Visual Demo -->
          <div class="relative rounded-2xl overflow-hidden order-2 md:order-1">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-400 to-cyan-500 opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
            <div class="relative bg-gradient-to-br from-blue-50 via-blue-25 to-cyan-50 p-12 rounded-2xl border-2 border-blue-200/50 group-hover:border-blue-300 transition-all duration-500 hover:shadow-2xl">
              <div class="text-7xl mb-6 inline-block p-4 bg-blue-100 rounded-2xl group-hover:bg-blue-200 transition-colors">📌</div>
              <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white p-6 rounded-xl text-sm font-mono space-y-3 group-hover:shadow-lg transition-shadow">
                <div class="font-bold text-blue-100">User Input:</div>
                <div class="text-yellow-300">"Summarize John 3:16"</div>
                <div class="mt-4 pt-4 border-t border-blue-400 flex items-center gap-2">
                  <span class="animate-pulse">→</span>
                  <span class="text-blue-100">Processing with AI...</span>
                </div>
                <div class="mt-4 pt-4 border-t border-blue-400">
                  <div class="font-bold text-blue-100 mb-2">AI Response:</div>
                  <div class="text-white leading-relaxed text-xs">
                    "John 3:16 expresses God's profound love for humanity. It teaches that God gave His only Son so anyone believing in Him..."
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Description -->
          <div class="order-1 md:order-2">
            <div class="inline-block px-4 py-2 rounded-full bg-blue-100 border border-blue-200 mb-4">
              <span class="text-sm font-bold text-blue-700">📌 FEATURE #1</span>
            </div>
            <h2 class="text-5xl font-black mb-6 text-gray-900">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-cyan-600">
                Instant Summaries
              </span>
            </h2>
            <p class="text-lg text-gray-700 mb-8 leading-relaxed">
              Get concise, AI-powered summaries of any Bible passage in seconds. Perfect for quick understanding and daily devotions. Our AI extracts the core message while preserving theological accuracy.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span class="text-blue-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Single or Multiple:</strong> Works with single verses or entire chapters</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-blue-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>AI-Powered:</strong> Concise explanations that respect scripture's depth</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-blue-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Daily Reading:</strong> Perfect for morning devotions and quick study</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-blue-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Beginner-Friendly:</strong> Complex passages simplified without losing meaning</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Feature 2: Key Points -->
      <div class="group">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Description -->
          <div>
            <div class="inline-block px-4 py-2 rounded-full bg-emerald-100 border border-emerald-200 mb-4">
              <span class="text-sm font-bold text-emerald-700">🔑 FEATURE #2</span>
            </div>
            <h2 class="text-5xl font-black mb-6 text-gray-900">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-emerald-600 to-teal-600">
                Key Points & Themes
              </span>
            </h2>
            <p class="text-lg text-gray-700 mb-8 leading-relaxed">
              Discover the main theological concepts and important messages hidden in scripture. Our AI identifies the core themes so you understand what God is communicating.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span class="text-emerald-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Theological Themes:</strong> Extract main theological concepts with accuracy</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-emerald-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Key Messages:</strong> Identify messages and concepts central to scripture</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-emerald-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Author's Intent:</strong> Understand the original author's intent and purpose</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-emerald-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Deep Study:</strong> Perfect for serious, scholarly Bible study</span>
              </li>
            </ul>
          </div>

          <!-- Right: Visual Demo -->
          <div class="relative rounded-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-400 to-teal-500 opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
            <div class="relative bg-gradient-to-br from-emerald-50 via-emerald-25 to-teal-50 p-12 rounded-2xl border-2 border-emerald-200/50 group-hover:border-emerald-300 transition-all duration-500 hover:shadow-2xl">
              <div class="text-7xl mb-6 inline-block p-4 bg-emerald-100 rounded-2xl group-hover:bg-emerald-200 transition-colors">🔑</div>
              <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 text-white p-6 rounded-xl text-sm font-mono space-y-4 group-hover:shadow-lg transition-shadow">
                <div class="font-bold text-emerald-100">Key Themes Found:</div>
                <div class="space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span>Divine Love & Compassion</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span>Sacrifice & Redemption</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span>Belief & Faith in Christ</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span>Eternal Life & Salvation</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 3: Cross References -->
      <div class="group">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Visual Demo -->
          <div class="relative rounded-2xl overflow-hidden order-2 md:order-1">
            <div class="absolute inset-0 bg-gradient-to-br from-orange-400 to-amber-500 opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
            <div class="relative bg-gradient-to-br from-orange-50 via-orange-25 to-amber-50 p-12 rounded-2xl border-2 border-orange-200/50 group-hover:border-orange-300 transition-all duration-500 hover:shadow-2xl">
              <div class="text-7xl mb-6 inline-block p-4 bg-orange-100 rounded-2xl group-hover:bg-orange-200 transition-colors">🔗</div>
              <div class="bg-gradient-to-br from-orange-500 to-orange-600 text-white p-6 rounded-xl text-sm font-mono space-y-3 group-hover:shadow-lg transition-shadow">
                <div class="font-bold text-orange-100">Related Passages Found:</div>
                <div class="space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span class="text-white font-bold">John 1:1</span>
                    <span class="text-orange-100 text-xs ml-auto">The Word divine</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span class="text-white font-bold">Romans 5:8</span>
                    <span class="text-orange-100 text-xs ml-auto">God's love proven</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span class="text-white font-bold">1 John 4:9-10</span>
                    <span class="text-orange-100 text-xs ml-auto">Love defined</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-300">•</span>
                    <span class="text-white font-bold">Ephesians 2:8-9</span>
                    <span class="text-orange-100 text-xs ml-auto">Grace explained</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Description -->
          <div class="order-1 md:order-2">
            <div class="inline-block px-4 py-2 rounded-full bg-orange-100 border border-orange-200 mb-4">
              <span class="text-sm font-bold text-orange-700">🔗 FEATURE #3</span>
            </div>
            <h2 class="text-5xl font-black mb-6 text-gray-900">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-600 to-amber-600">
                Cross References
              </span>
            </h2>
            <p class="text-lg text-gray-700 mb-8 leading-relaxed">
              Find related passages and connections across the entire Bible. Build a deeper understanding by exploring how different passages relate to each other, creating a tapestry of biblical truth.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span class="text-orange-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Automatic Discovery:</strong> Find related Bible verses automatically</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-orange-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Connection Mapping:</strong> See how passages connect and relate</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-orange-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Comprehensive View:</strong> Build comprehensive understanding of themes</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-orange-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Topical Studies:</strong> Perfect for topical and thematic research</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Feature 4: Historical Context -->
      <div class="group">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Description -->
          <div>
            <div class="inline-block px-4 py-2 rounded-full bg-rose-100 border border-rose-200 mb-4">
              <span class="text-sm font-bold text-rose-700">📚 FEATURE #4</span>
            </div>
            <h2 class="text-5xl font-black mb-6 text-gray-900">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-rose-600 to-red-600">
                Historical & Cultural Context
              </span>
            </h2>
            <p class="text-lg text-gray-700 mb-8 leading-relaxed">
              Learn the cultural, historical, and theological background of passages. Understand the world in which the passage was written to unlock deeper insight into scripture's meaning.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span class="text-rose-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Historical Background:</strong> Understand when and why passages were written</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-rose-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Cultural Context:</strong> Learn customs and traditions of biblical times</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-rose-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Theological Significance:</strong> Discover deeper theological implications</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-rose-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Serious Study:</strong> Perfect for scholarly and in-depth research</span>
              </li>
            </ul>
          </div>

          <!-- Right: Visual Demo -->
          <div class="relative rounded-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-rose-400 to-red-500 opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
            <div class="relative bg-gradient-to-br from-rose-50 via-rose-25 to-red-50 p-12 rounded-2xl border-2 border-rose-200/50 group-hover:border-rose-300 transition-all duration-500 hover:shadow-2xl">
              <div class="text-7xl mb-6 inline-block p-4 bg-rose-100 rounded-2xl group-hover:bg-rose-200 transition-colors">📚</div>
              <div class="bg-gradient-to-br from-rose-500 to-red-600 text-white p-6 rounded-xl text-sm font-mono space-y-3 group-hover:shadow-lg transition-shadow">
                <div class="font-bold text-rose-100">Historical Context:</div>
                <div class="space-y-2">
                  <div class="flex justify-between items-center">
                    <span class="text-rose-200 font-bold">Time Period:</span>
                    <span class="text-yellow-300">1st Century AD</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-rose-200 font-bold">Location:</span>
                    <span class="text-yellow-300">Judea & Galilee</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-rose-200 font-bold">Culture:</span>
                    <span class="text-yellow-300">Jewish traditions</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-rose-200 font-bold">Theme:</span>
                    <span class="text-yellow-300">Salvation & Love</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 5: Custom Questions -->
      <div class="group">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Visual Demo -->
          <div class="relative rounded-2xl overflow-hidden order-2 md:order-1">
            <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-400 to-pink-500 opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
            <div class="relative bg-gradient-to-br from-fuchsia-50 via-pink-25 to-rose-50 p-12 rounded-2xl border-2 border-fuchsia-200/50 group-hover:border-fuchsia-300 transition-all duration-500 hover:shadow-2xl">
              <div class="text-7xl mb-6 inline-block p-4 bg-fuchsia-100 rounded-2xl group-hover:bg-fuchsia-200 transition-colors">❓</div>
              <div class="bg-gradient-to-br from-fuchsia-500 to-pink-600 text-white p-6 rounded-xl text-sm font-mono space-y-3 group-hover:shadow-lg transition-shadow">
                <div class="font-bold text-fuchsia-100">Your Question:</div>
                <div class="text-yellow-300 text-base italic">"What does 'born again' mean in John 3?"</div>
                <div class="mt-4 pt-4 border-t border-fuchsia-400 flex items-center gap-2">
                  <span class="animate-pulse">→</span>
                  <span class="text-fuchsia-100">Processing with AI...</span>
                </div>
                <div class="mt-4 pt-4 border-t border-fuchsia-400">
                  <div class="font-bold text-fuchsia-100 mb-2">AI Response:</div>
                  <div class="text-white leading-relaxed text-xs">
                    "Being 'born again' means spiritual rebirth through faith in Jesus Christ. It's transformation from the old nature to a new life in Christ..."
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Description -->
          <div class="order-1 md:order-2">
            <div class="inline-block px-4 py-2 rounded-full bg-fuchsia-100 border border-fuchsia-200 mb-4">
              <span class="text-sm font-bold text-fuchsia-700">❓ FEATURE #5</span>
            </div>
            <h2 class="text-5xl font-black mb-6 text-gray-900">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-fuchsia-600 to-pink-600">
                Custom Questions
              </span>
            </h2>
            <p class="text-lg text-gray-700 mb-8 leading-relaxed">
              Ask anything about passages and get AI-powered answers grounded in scripture. Receive personalized learning tailored to your specific interests and spiritual journey.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span class="text-fuchsia-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Unlimited Questions:</strong> Ask as many questions as you want</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-fuchsia-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Scripture-Based:</strong> All answers grounded in biblical text</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-fuchsia-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Personalized Learning:</strong> Tailored to your interests and goals</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-fuchsia-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Exploration-Friendly:</strong> Perfect for deep spiritual exploration</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Feature 6: Security -->
      <div class="group">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Description -->
          <div>
            <div class="inline-block px-4 py-2 rounded-full bg-indigo-100 border border-indigo-200 mb-4">
              <span class="text-sm font-bold text-indigo-700">🔐 FEATURE #6</span>
            </div>
            <h2 class="text-5xl font-black mb-6 text-gray-900">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 to-blue-600">
                100% Secure & Private
              </span>
            </h2>
            <p class="text-lg text-gray-700 mb-8 leading-relaxed">
              Your study remains completely private. No data collection. Your API key is stored locally only. Complete peace of mind knowing your spiritual journey is protected.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span class="text-indigo-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Local Storage:</strong> API key stored locally on your computer only</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-indigo-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Zero Collection:</strong> No personal data collection whatsoever</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-indigo-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>No Tracking:</strong> No cookies, trackers, or analytics</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-indigo-600 font-bold text-xl mt-1">✓</span>
                <span class="text-gray-700"><strong>Sacred Privacy:</strong> Your spiritual journey is completely private</span>
              </li>
            </ul>
          </div>

          <!-- Right: Visual Demo -->
          <div class="relative rounded-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-400 to-blue-500 opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
            <div class="relative bg-gradient-to-br from-indigo-50 via-indigo-25 to-blue-50 p-12 rounded-2xl border-2 border-indigo-200/50 group-hover:border-indigo-300 transition-all duration-500 hover:shadow-2xl">
              <div class="text-7xl mb-6 inline-block p-4 bg-indigo-100 rounded-2xl group-hover:bg-indigo-200 transition-colors">🔐</div>
              <div class="bg-gradient-to-br from-indigo-500 to-blue-600 text-white p-6 rounded-xl text-sm font-mono space-y-2 group-hover:shadow-lg transition-shadow">
                <div class="font-bold text-indigo-100 mb-3">Security Features:</div>
                <div class="space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-green-300 font-bold">✓</span>
                    <span>Local storage only (never sent to servers)</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-green-300 font-bold">✓</span>
                    <span>End-to-end HTTPS encryption</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-green-300 font-bold">✓</span>
                    <span>No tracking or analytics</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-green-300 font-bold">✓</span>
                    <span>Open source & auditable</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-green-300 font-bold">✓</span>
                    <span>GDPR & privacy compliant</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table Section -->
  <section class="py-32 bg-gradient-to-b from-white via-gray-50/30 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-100/40 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-100/40 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4">
