---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Grid from '../../components/ui/Grid.astro';
import Button from '../../components/ui/Button.astro';
import CTA from '../../components/ui/CTA.astro';

const { topic } = Astro.params;

// Mock data - in production, fetch from content collection
const guides = {
  'john': {
    title: 'Gospel of John - Complete Study Guide',
    book: 'John',
    chapters: 21,
    description: 'A comprehensive verse-by-verse study of the Gospel of John',
    overview: 'The Gospel of John is unique among the four gospels in its theological depth and emphasis on Jesus as the Word of God. This guide explores the themes of faith, belief, and eternal life as John presents them.',
    lessons: [
      { chapter: 1, title: 'The Word Became Flesh', verses: '1:1-18' },
      { chapter: 2, title: 'Turning Water into Wine', verses: '2:1-11' },
      { chapter: 3, title: 'Born Again', verses: '3:1-36' },
      { chapter: 4, title: 'The Samaritan Woman', verses: '4:1-42' },
      { chapter: 5, title: 'Healing on the Sabbath', verses: '5:1-47' },
    ],
  },
  'romans': {
    title: 'Romans - Paul\'s Masterpiece',
    book: 'Romans',
    chapters: 16,
    description: 'Study Paul\'s theological masterpiece on justification and grace',
    overview: 'Romans is Paul\'s most systematic presentation of the gospel. This guide covers themes of sin, grace, justification, and Christian living.',
    lessons: [
      { chapter: 1, title: 'Paul\'s Purpose', verses: '1:1-17' },
      { chapter: 3, title: 'Justification by Faith', verses: '3:21-31' },
      { chapter: 8, title: 'No Condemnation', verses: '8:1-39' },
      { chapter: 12, title: 'Living Sacrifice', verses: '12:1-21' },
    ],
  },
};

const guide = guides[topic] || {
  title: `${topic} - Study Guide`,
  book: topic,
  chapters: 0,
  description: 'Study guide coming soon',
  overview: 'Study guide not yet available',
  lessons: [],
};

const pageTitle = `${guide.title} - Bible Study Hub`;
const pageDescription = guide.description;
---

<MainLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <Section class="bg-gradient-to-b from-purple-50 to-white">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-100 border border-purple-200">
        <span class="text-sm font-bold text-purple-700">📚 Bible Study Guide</span>
      </div>

      <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
        {guide.title}
      </h1>

      <p class="text-xl text-gray-600 mb-8">
        {guide.description}
      </p>

      <div class="flex flex-wrap gap-4 items-center">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📖</span>
          <span class="font-semibold text-gray-900">{guide.book}</span>
        </div>
        <div class="h-6 border-l border-gray-300"></div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">📝</span>
          <span class="font-semibold text-gray-900">{guide.chapters} Chapters</span>
        </div>
      </div>
    </div>
  </Section>

  <!-- Overview Section -->
  <Section class="bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl font-bold text-gray-900 mb-6">Overview</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-8">
        {guide.overview}
      </p>

      <div class="bg-purple-50 rounded-2xl p-8 border border-purple-200">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">How to Use This Guide</h3>
        <ol class="space-y-3">
          <li class="flex gap-3">
            <span class="text-purple-600 font-bold flex-shrink-0">1.</span>
            <span class="text-gray-700">Read the chapter introduction and main scripture passage</span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-600 font-bold flex-shrink-0">2.</span>
            <span class="text-gray-700">Study the verse-by-verse commentary and insights</span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-600 font-bold flex-shrink-0">3.</span>
            <span class="text-gray-700">Reflect on discussion questions and applications</span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-600 font-bold flex-shrink-0">4.</span>
            <span class="text-gray-700">Use AI insights for deeper understanding</span>
          </li>
        </ol>
      </div>
    </div>
  </Section>

  <!-- Lessons Grid -->
  <Section class="bg-gray-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl font-bold text-gray-900 mb-12">Lessons</h2>

      <div class="space-y-4">
        {guide.lessons.map((lesson) => (
          <a
            href={`#lesson-${lesson.chapter}`}
            class="block bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-lg hover:border-purple-200 transition-all duration-300"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="text-sm font-semibold text-purple-600 mb-2">
                  Chapter {lesson.chapter}
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">
                  {lesson.title}
                </h3>
                <p class="text-gray-600">
                  {lesson.verses}
                </p>
              </div>
              <span class="text-2xl text-gray-400">›</span>
            </div>
          </a>
        ))}
      </div>

      {guide.lessons.length === 0 && (
        <div class="text-center py-12">
          <p class="text-gray-600 text-lg">
            This guide is currently being developed. Check back soon!
          </p>
        </div>
      )}
    </div>
  </Section>

  <!-- Resources Section -->
  <Section>
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl font-bold text-gray-900 mb-12">Study Resources</h2>

      <Grid cols={2}>
        <Card>
          <div class="text-4xl mb-4">📖</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Scripture Reference</h3>
          <p class="text-gray-600 mb-4">Read the full text with multiple translations</p>
          <Button href="https://bible.com" target="_blank" rel="noopener noreferrer" variant="outline" size="sm">
            Open Bible.com
          </Button>
        </Card>

        <Card>
          <div class="text-4xl mb-4">🤖</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">AI Commentary</h3>
          <p class="text-gray-600 mb-4">Get instant AI-powered insights and analysis</p>
          <Button href="/pricing" variant="outline" size="sm">
            Try AI Analysis
          </Button>
        </Card>

        <Card>
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Discussion Questions</h3>
          <p class="text-gray-600 mb-4">Thought-provoking questions for reflection</p>
          <Button href="#" variant="outline" size="sm">
            View Questions
          </Button>
        </Card>

        <Card>
          <div class="text-4xl mb-4">🔗</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Cross-References</h3>
          <p class="text-gray-600 mb-4">Find related passages throughout Scripture</p>
          <Button href="#" variant="outline" size="sm">
            Explore Links
          </Button>
        </Card>
      </Grid>
    </div>
  </Section>

  <!-- CTA Section -->
  <CTA
    title="Study Deeper with AI"
    description="Get instant insights, commentary, and analysis for every verse using our AI-powered study tools."
    primaryCTA={{ text: 'Start Free Trial', href: 'https://chrome.google.com/webstore' }}
    secondaryCTA={{ text: 'View Pricing', href: '/pricing' }}
  />
</MainLayout>
