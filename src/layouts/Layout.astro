---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Bible Study Hub - AI-Powered Bible Learning with Chrome Extension" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white shadow">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <!-- Logo -->
        <a href="/" class="text-2xl font-bold text-purple-600">
          📖 Bible Study Hub
        </a>

        <!-- Navigation Links -->
        <ul class="hidden md:flex gap-8 items-center">
          <li><a href="/" class="hover:text-purple-600 transition">Home</a></li>
          <li><a href="/features" class="hover:text-purple-600 transition">Features</a></li>
          <li><a href="/blog" class="hover:text-purple-600 transition">Blog</a></li>
          <li><a href="/pricing" class="hover:text-purple-600 transition">Pricing</a></li>
        </ul>

        <!-- Download Button -->
        <a href="https://chrome.google.com/webstore" target="_blank"
           class="bg-purple-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-purple-700 transition hidden md:inline-block">
          📥 Download
        </a>

        <!-- Mobile Menu Button (Future) -->
        <button class="md:hidden text-2xl">☰</button>
      </nav>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
          <!-- Column 1 -->
          <div>
            <h3 class="font-bold text-lg mb-4">📖 Bible Study Hub</h3>
            <p class="text-gray-400 text-sm">
              AI-powered Bible study tool for deeper learning and understanding.
            </p>
          </div>

          <!-- Column 2 -->
          <div>
            <h3 class="font-bold mb-4">Product</h3>
            <ul class="text-gray-400 text-sm space-y-2">
              <li><a href="/features" class="hover:text-white transition">Features</a></li>
              <li><a href="/pricing" class="hover:text-white transition">Pricing</a></li>
              <li><a href="https://chrome.google.com/webstore" target="_blank" class="hover:text-white transition">Download</a></li>
            </ul>
          </div>

          <!-- Column 3 -->
          <div>
            <h3 class="font-bold mb-4">Learn</h3>
            <ul class="text-gray-400 text-sm space-y-2">
              <li><a href="/blog" class="hover:text-white transition">Blog</a></li>
              <li><a href="/guides" class="hover:text-white transition">Study Guides</a></li>
              <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
            </ul>
          </div>

          <!-- Column 4 -->
          <div>
            <h3 class="font-bold mb-4">Legal</h3>
            <ul class="text-gray-400 text-sm space-y-2">
              <li><a href="/privacy" class="hover:text-white transition">Privacy</a></li>
              <li><a href="/terms" class="hover:text-white transition">Terms</a></li>
              <li><a href="/contact" class="hover:text-white transition">Contact</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom Footer -->
        <div class="border-t border-gray-800 pt-8 text-center text-gray-400 text-sm">
          <p>© 2026 Bible Study Hub. All rights reserved.</p>
          <p class="mt-2">Made with 📖 for Bible lovers everywhere</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.6;
    color: #333;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  button {
    cursor: pointer;
  }
</style>
