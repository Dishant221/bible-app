---
export interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className, hover = true } = Astro.props;

const baseStyles = 'bg-white rounded-2xl border border-gray-200 p-6';
const hoverStyles = hover ? 'hover:shadow-lg hover:border-purple-200 transition-all duration-300' : '';
---

<div class={`${baseStyles} ${hoverStyles} ${className || ''}`}>
  <slot />
</div>
