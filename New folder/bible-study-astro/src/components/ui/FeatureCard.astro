---
export interface Props {
  icon: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className } = Astro.props;
---

<div class={`group bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-xl hover:border-purple-200 transition-all duration-300 hover:-translate-y-2 ${className || ''}`}>
  <div class="text-5xl mb-4 transform group-hover:scale-110 transition-transform duration-300">
    {icon}
  </div>
  <h3 class="text-2xl font-bold text-gray-900 mb-3">
    {title}
  </h3>
  <p class="text-gray-600 leading-relaxed">
    {description}
  </p>
</div>
