---
export interface Props {
  text: string;
  author: string;
  role: string;
  avatar?: string;
  rating?: number;
}

const { text, author, role, avatar = '👤', rating = 5 } = Astro.props;
---

<div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-all duration-300">
  <div class="flex gap-1 mb-4">
    {[...Array(rating)].map(() => (
      <span class="text-yellow-400">⭐</span>
    ))}
  </div>

  <blockquote class="text-gray-700 mb-6 text-lg leading-relaxed italic">
    "{text}"
  </blockquote>

  <div class="flex items-center gap-4">
    <div class="text-3xl">{avatar}</div>
    <div>
      <p class="font-bold text-gray-900">{author}</p>
      <p class="text-gray-600 text-sm">{role}</p>
    </div>
  </div>
</div>
