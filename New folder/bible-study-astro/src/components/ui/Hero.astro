---
import Button from './Button.astro';
import Badge from './Badge.astro';

export interface Props {
  badge?: string;
  title: string;
  description: string;
  primaryCTA?: {
    text: string;
    href: string;
    icon?: string;
  };
  secondaryCTA?: {
    text: string;
    href: string;
    icon?: string;
  };
  class?: string;
}

const {
  badge,
  title,
  description,
  primaryCTA,
  secondaryCTA,
  class: className
} = Astro.props;
---

<section class={`relative min-h-screen bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-900 text-white overflow-hidden flex items-center ${className || ''}`}>
  <!-- Animated background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-400/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-indigo-400/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/3 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 4s;"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 py-32 w-full text-center">
    {badge && (
      <div class="mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 hover:border-white/40 transition">
        <span class="text-sm font-semibold text-purple-100">{badge}</span>
      </div>
    )}

    <h1 class="text-6xl md:text-7xl lg:text-8xl font-black mb-6 leading-tight">
      <slot name="title">
        {title}
      </slot>
    </h1>

    <p class="text-xl md:text-2xl text-purple-100 mb-4 max-w-2xl mx-auto leading-relaxed">
      {description}
    </p>

    {(primaryCTA || secondaryCTA) && (
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-12">
        {primaryCTA && (
          <Button
            href={primaryCTA.href}
            variant="secondary"
            size="lg"
            icon={primaryCTA.icon}
          >
            {primaryCTA.text}
          </Button>
        )}
        {secondaryCTA && (
          <Button
            href={secondaryCTA.href}
            variant="outline"
            size="lg"
            class="border-white/30 text-white hover:bg-white/10"
            icon={secondaryCTA.icon}
          >
            {secondaryCTA.text}
          </Button>
        )}
      </div>
    )}
  </div>
</section>
