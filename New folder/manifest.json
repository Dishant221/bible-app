{
  "manifest_version": 3,
  "name": "Bible Study Assistant",
  "version": "1.0.0",
  "description": "AI-powered Bible study assistant for biblegateway.com. Ask questions, summarize passages, and understand scripture deeper with Google Gemini.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.biblegateway.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bible Study Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://www.biblegateway.com/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
